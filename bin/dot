#!/usr/bin/env bash
# Manage these dotfiles with `dot install`, `dot stow`, or the other subcommands.
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  directory="$(cd "$(dirname "$script")" && pwd)"
  script="$(readlink "$script")"
  [[ "$script" = /* ]] || script="$directory/$script"
done
repo="$(cd "$(dirname "$script")/.." && pwd)"

usage() {
  cat <<'EOF'
usage: dot <command> [arguments]

Commands:
  install          Run pre, stow, and post
  pre              Run pre-stow setup
  stow             Stow files into the home directory
  post             Run post-stow setup
  theme ...        Manage themes
  help             Show this help
EOF
}

command="${1:-help}"
case "$command" in
  install)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    "$repo/bin/dotfiles-setup" pre
    "$repo/bin/dotfiles-stow"
    exec "$repo/bin/dotfiles-setup" post
    ;;
  pre | post)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec "$repo/bin/dotfiles-setup" "$command"
    ;;
  stow)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec "$repo/bin/dotfiles-stow"
    ;;
  theme)
    shift
    exec dotfiles-theme "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "dot: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac

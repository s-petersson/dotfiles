#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
phase="${1:-all}"

source "$repo/lib/dotfiles/work-repo.sh"
dotfiles_resolve_work_repo "$repo"
work_repo="$DOTFILES_RESOLVED_WORK_REPO"

run_phase() {
  local source_repo="$1"
  local name="$2"
  local kind="$3"
  local dir="$source_repo/setup/$name"

  if [ ! -d "$dir" ]; then
    echo "==> No $kind setup/$name/ directory found; skipping"
    return 0
  fi

  local found=0
  for script in "$dir"/*.sh; do
    [ -e "$script" ] || continue
    found=1

    if [ ! -x "$script" ]; then
      echo "==> Skipping non-executable setup script: $script"
      continue
    fi

    echo "==> Running $script"
    DOTFILES_REPO="$source_repo" \
      DOTFILES_LIB="$repo/lib/dotfiles" \
      "$script"
  done

  if [ "$found" -eq 0 ]; then
    echo "==> No $kind setup/$name scripts found"
  fi
}

run_all_repos() {
  local name="$1"

  run_phase "$repo" "$name" public
  if [ -n "$work_repo" ]; then
    run_phase "$work_repo" "$name" work
  fi
}

case "$phase" in
  pre)
    run_all_repos pre
    ;;
  post)
    run_all_repos post
    ;;
  all)
    run_all_repos pre
    run_all_repos post
    ;;
  *)
    echo "usage: ${0##*/} [pre|post|all]" >&2
    exit 2
    ;;
esac

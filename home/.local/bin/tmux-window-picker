#!/bin/sh
set -eu

selection=$(
  tmux-window-list | tmux-fzf-popup \
    --no-sort \
    --delimiter '\t' \
    --with-nth 2 \
    --border-label ' windows ' \
    --prompt '>  ' \
    --preview 'tmux capture-pane -ep -t {1}'
) || exit 0

target=$(printf '%s\n' "$selection" | cut -f1)
[ -n "$target" ] && tmux switch-client -t "$target"

#!/bin/sh
# Choose or kill a tmux session with fzf; tmux binds this to prefix+w.
set -eu

selection=$(
  tmux-session-list | tmux-fzf-popup \
    --no-sort \
    --delimiter '\t' \
    --with-nth 2 \
    --border-label ' sessions ' \
    --prompt '>  ' \
    --header '  ^d kill session' \
    --preview 'tmux capture-pane -ep -t {1}' \
    --bind 'ctrl-d:execute(tmux kill-session -t {1})+reload(tmux-session-list)'
) || exit 0

target=$(printf '%s\n' "$selection" | cut -f1)
[ -n "$target" ] && tmux switch-client -t "=$target"

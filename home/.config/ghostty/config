# Static fallback, overridden by Omarchy when available
theme = gruvbox-catppuccin-mocha
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
config-file = ?"~/.local/state/dotfiles/theme/current/ghostty.conf"

# Start zsh in new terminal windows instead of the account's login shell
command = zsh

font-size = 9
adjust-cell-height = 20%

window-decoration = none
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
resize-overlay = never

shell-integration-features = no-cursor,ssh-env
custom-shader = "~/.config/ghostty/cursor-warp.glsl"

# Let TUIs distinguish modified keys
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = ctrl+shift+h=csi:104;6u
keybind = ctrl+shift+j=csi:106;6u
keybind = ctrl+shift+k=csi:107;6u
keybind = ctrl+shift+l=csi:108;6u

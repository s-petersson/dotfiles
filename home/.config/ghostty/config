# Static fallback, overridden by Omarchy when available
theme = gruvbox-catppuccin-mocha
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

font-size = 12
adjust-cell-height = 20%

window-decoration = none
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
resize-overlay = never

shell-integration-features = no-cursor,ssh-env
custom-shader = "~/.config/ghostty/cursor-warp.glsl"

# Let TUIs distinguish modified Enter keys
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

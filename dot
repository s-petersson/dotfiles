#!/usr/bin/env bash
# Manage these dotfiles with `dot install`, `dot stow`, or the other subcommands.
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  directory="$(cd "$(dirname "$script")" && pwd)"
  script="$(readlink "$script")"
  [[ "$script" = /* ]] || script="$directory/$script"
done
repo="$(cd "$(dirname "$script")" && pwd)"

source "$repo/lib/dotfiles/platform.sh"
source "$repo/lib/dotfiles/private-repo.sh"
dotfiles_resolve_private_repo "$repo"
private_repo="$DOTFILES_RESOLVED_PRIVATE_REPO"

usage() {
  cat <<'EOF'
usage: dot <command> [arguments]

Commands:
  install          Run pre, stow, and post
  pre              Run pre-stow setup
  stow             Stow files into the home directory
  post             Run post-stow setup
  theme ...        Manage themes
  help             Show this help
EOF
}

run_phase() {
  local source_repo="$1"
  local name="$2"
  local kind="$3"
  local dir="$source_repo/$name"

  if [ ! -d "$dir" ]; then
    echo "==> No $kind $name/ directory found; skipping"
    return 0
  fi

  local found=0
  for setup_script in "$dir"/*.sh; do
    [ -e "$setup_script" ] || continue
    found=1

    if [ ! -x "$setup_script" ]; then
      echo "==> Skipping non-executable setup script: $setup_script"
      continue
    fi

    echo "==> Running $setup_script"
    DOTFILES_REPO="$source_repo" \
      DOTFILES_LIB="$repo/lib/dotfiles" \
      "$setup_script"
  done

  if [ "$found" -eq 0 ]; then
    echo "==> No $kind $name scripts found"
  fi
}

run_setup() {
  local phase="$1"

  run_phase "$repo" "$phase" public
  if [ -n "$private_repo" ]; then
    run_phase "$private_repo" "$phase" private
  fi
}

stow_home() {
  local source_repo="$1"
  shift

  [ -d "$source_repo/home" ] || return 0
  stow --no-folding "$@" -d "$source_repo" -t "$HOME" home
}

unstow_platform_homes() {
  local platform_repo

  for platform_repo in "$repo"/platform/*; do
    [ -d "$platform_repo/home" ] || continue
    stow_home "$platform_repo" -D
  done
}

stow_dotfiles() {
  if ! command -v stow >/dev/null 2>&1; then
    echo "error: GNU stow is required but was not found in PATH" >&2
    return 1
  fi

  if [ -n "$private_repo" ]; then
    echo "==> Unstowing previous private dotfiles from $private_repo/home"
    stow_home "$private_repo" -D
  fi

  echo "==> Unstowing previous public dotfiles from $repo/home"
  unstow_platform_homes
  stow_home "$repo" -D

  local ignore_args=()
  local has_ignore_args=0
  if [ -n "$private_repo" ] && [ -d "$private_repo/home" ]; then
    local file relative escaped
    while IFS= read -r -d '' file; do
      relative="${file#"$private_repo/home/"}"
      escaped="$(printf '%s' "$relative" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
      ignore_args+=(--ignore="^${escaped}$")
      has_ignore_args=1
    done < <(find "$private_repo/home" \( -type f -o -type l \) -print0)
  fi

  echo "==> Stowing public home/ into $HOME"
  if [ "$has_ignore_args" -eq 1 ]; then
    stow_home "$repo" "${ignore_args[@]}"
  else
    stow_home "$repo"
  fi

  local platform
  platform=$(dotfiles_platform)
  if [ -d "$repo/platform/$platform/home" ]; then
    echo "==> Stowing $platform home files into $HOME"
    if [ "$has_ignore_args" -eq 1 ]; then
      stow_home "$repo/platform/$platform" "${ignore_args[@]}"
    else
      stow_home "$repo/platform/$platform"
    fi
  fi

  if [ -n "$private_repo" ]; then
    echo "==> Stowing private home/ from $private_repo into $HOME"
    stow_home "$private_repo"
  fi
}

command="${1:-help}"
case "$command" in
  install)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    run_setup pre
    stow_dotfiles
    run_setup post
    ;;
  pre | post)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    run_setup "$command"
    ;;
  stow)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    stow_dotfiles
    ;;
  theme)
    shift
    exec dotfiles-theme "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "dot: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
